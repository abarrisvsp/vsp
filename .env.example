# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public URL. Drives sitemap/schema/metadata AND the NextAuth sign-in
# redirect. In production this MUST be the live domain or /admin will bounce to
# the wrong host. Local dev can leave it unset (falls back to the prod domain).
NEXT_PUBLIC_SITE_URL=https://visionarysoundproductions.com

# Auth.js (NextAuth v5). NEXTAUTH_URL must match the canonical domain in prod.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Admin credentials.
# ADMIN_EMAIL is where passwordless sign-in codes are sent.
# ADMIN_PASSWORD_HASH is the break-glass fallback only (see SETUP.md); not used by the UI.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Email (Resend). Required for sign-in codes AND contact/blog emails.
# RESEND_FROM must be an address on a domain verified in Resend so mail to
# Aaron@VisionarySoundProductions.com actually delivers.
RESEND_API_KEY=
RESEND_FROM=

# reCAPTCHA v2 (checkbox). Site key is public; secret is server-side only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Scheduled publishing cron (Vercel)
CRON_SECRET=
